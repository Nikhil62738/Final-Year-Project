{
  "expo": {
    "name": "Aaharmitra",
    "slug": "fda-safewatch",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/aaharmitra-app-icon.png",
    "splash": {
      "image": "./assets/aaharmitra-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFCF9"
    },
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nikhil6273.fdasafewatch",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFCF9",
        "foregroundImage": "./assets/aaharmitra-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nikhil6273.fdasafewatch",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/aaharmitra-app-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-location",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "6a46a159-ce0d-447b-a1f8-545324010f96"
      }
    }
  }
}
